datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum FatwaCategory {
  MUAMALAH
  IBADAH_KESEHATAN
  DIREKTORI_KONTEMPORER
}

enum NewsSection {
  KABAR_JAKARTA_TIMUR
  OPINI_ULAMA
  RILIS_PERS
}

enum ArticleSection {
  DOA_DZIKIR
  HIKMAH_AKHLAK
  KHUTBAH_JUMAT
  FIQIH_WANITA
  PARENTING
  KITAB_KAMUS
  KITAB_TURATS
}

/// Mirror of Supabase auth.users — id MUST equal auth.users.id (managed by a DB trigger,
/// see supabase/migrations). Prisma does not manage auth.users itself.
model Profile {
  id        String   @id @db.Uuid
  username  String   @unique
  email     String   @unique
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  avatarUrl String?  @map("avatar_url")
  role      Role     @default(USER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  comments      Comment[]
  news          News[]
  fatwas        Fatwa[]
  faqs          FaqTanyaUlama[]
  pengurus      Pengurus[]
  bidangKomisi  BidangKomisi[]
  heroSlides    HeroSlide[]
  pageContents  PageContent[]
  articles      Article[]
  pageViews     PageView[]
  deletedComments Comment[] @relation("CommentDeletedBy")

  @@map("profiles")
}

model News {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  title       String
  category    String
  section     NewsSection   @default(KABAR_JAKARTA_TIMUR)
  excerpt     String
  body        String
  imageUrl    String?       @map("image_url")
  featured    Boolean       @default(false)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  updatedBy   String?       @map("updated_by") @db.Uuid
  updatedByProfile Profile? @relation(fields: [updatedBy], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("news")
}

model Fatwa {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  number      String?
  title       String
  category    FatwaCategory
  body        String
  pdfUrl      String?       @map("pdf_url")
  publishedAt DateTime?     @map("published_at")
  status      ContentStatus @default(DRAFT)
  updatedBy   String?       @map("updated_by") @db.Uuid
  updatedByProfile Profile? @relation(fields: [updatedBy], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("fatwa")
}

model FaqTanyaUlama {
  id        String        @id @default(uuid()) @db.Uuid
  question  String
  answer    String
  category  String
  keywords  Json          @default("[]")
  sortOrder Int           @default(0) @map("sort_order")
  status    ContentStatus @default(DRAFT)
  updatedBy String?       @map("updated_by") @db.Uuid
  updatedByProfile Profile? @relation(fields: [updatedBy], references: [id])
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("faq_tanya_ulama")
}

model Pengurus {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  position  String
  photoUrl  String?  @map("photo_url")
  period    String
  sortOrder Int      @default(0) @map("sort_order")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedByProfile Profile? @relation(fields: [updatedBy], references: [id])
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pengurus")
}

model BidangKomisi {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String
  chairName   String?  @map("chair_name")
  secretaryName String? @map("secretary_name")
  members     Json     @default("[]")
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedByProfile Profile? @relation(fields: [updatedBy], references: [id])
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("bidang_komisi")
}

model HeroSlide {
  id        String   @id @default(uuid()) @db.Uuid
  imageUrl  String   @map("image_url")
  title     String
  linkUrl   String?  @map("link_url")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedByProfile Profile? @relation(fields: [updatedBy], references: [id])

  @@map("hero_slide")
}

model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  contentType String   @map("content_type") // "news" | "fatwa" | "faq"
  contentId   String   @map("content_id") @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  author      Profile  @relation(fields: [authorId], references: [id])
  body        String
  createdAt   DateTime @default(now()) @map("created_at")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedBy   String?  @map("deleted_by") @db.Uuid
  deletedByProfile Profile? @relation("CommentDeletedBy", fields: [deletedBy], references: [id])

  /// contentType + contentId form a polymorphic reference ("news" | "fatwa" | "faq");
  /// intentionally no DB-level FK since one column can't target 3 parent tables —
  /// integrity is enforced in the app layer and by RLS policies instead.
  @@index([contentType, contentId])
  @@map("comments")
}

/// Generic key-value store: default_location, social integration tokens (encrypted at
/// rest via Supabase Vault — do not store raw secrets here in plaintext), feature flags.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Single free-text pages edited as one block (Sejarah, Visi & Misi, info Konsultasi),
/// as opposed to a list of items like Article/News.
model PageContent {
  key       String   @id
  title     String
  body      String
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedByProfile Profile? @relation(fields: [updatedBy], references: [id])
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("page_content")
}

/// Generic list content for the Amalan/Kitab/Keluarga sections (doa & dzikir, hikmah &
/// akhlak, khutbah Jumat, fiqih wanita, parenting, kamus istilah, kitab turats). Each
/// section renders the same list->detail UI; `extra` holds section-specific structured
/// fields (e.g. Arabic text + transliteration for a doa) without needing a table per section.
model Article {
  id        String         @id @default(uuid()) @db.Uuid
  section   ArticleSection
  slug      String
  title     String
  excerpt   String?
  body      String
  extra     Json           @default("{}")
  sortOrder Int            @default(0) @map("sort_order")
  status    ContentStatus  @default(DRAFT)
  updatedBy String?        @map("updated_by") @db.Uuid
  updatedByProfile Profile? @relation(fields: [updatedBy], references: [id])
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([section, slug])
  @@map("articles")
}

/// One row per page load, written by POST /api/track (see lib/track.ts). userId is set
/// when the visitor is logged in; anonymous visitors are only distinguished by
/// visitorId (a random id stored in a first-party cookie, not an IP address — IPs are
/// intentionally not stored here to keep this lightweight and privacy-conscious).
model PageView {
  id        String   @id @default(uuid()) @db.Uuid
  path      String
  userId    String?  @map("user_id") @db.Uuid
  userProfile Profile? @relation(fields: [userId], references: [id])
  visitorId String   @map("visitor_id")
  referrer  String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([path])
  @@index([createdAt])
  @@index([userId])
  @@map("page_views")
}
